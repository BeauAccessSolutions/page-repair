{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "page-repair-proxy",

  // Pinned deliberately. This Worker spent its life on the LANGWORTHYWATCH
  // Cloudflare account because nothing here said which account it belonged to —
  // wrangler just used whichever was cached, and the workers.dev subdomain it
  // handed back (airboat-webcast-5u) got baked into the extension's reviewed
  // host permission. With account_id set, a deploy from the wrong login fails
  // loudly instead of quietly creating a second copy somewhere else.
  // 39d7ced… = Beaudoin0zach@aol.com (Beau Access Solutions).
  "account_id": "39d7ced651572ee48cca6a29e1feebe9",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  // A custom domain on a zone we own, NOT the account's workers.dev subdomain.
  // The subdomain is derived from the ACCOUNT, so pointing the extension at one
  // means an account change silently breaks installs — and because the URL is an
  // MV3 host permission, fixing it costs a Chrome Web Store re-review. This
  // hostname survives any future account move.
  "routes": [
    { "pattern": "page-repair-proxy.beauaccesssolutions.com", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      "id": "ff79b0cc55da4e8fb5a4bb67154982a3"
    }
  ],
  // Per-token credit balances live in a Durable Object so the spend is atomic
  // (see CreditsAccount in src/index.ts). No external resource to provision —
  // the SQLite-backed class ships with the Worker on deploy.
  "durable_objects": {
    "bindings": [{ "name": "CREDITS", "class_name": "CreditsAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CreditsAccount"] }],
  "vars": {
    // Haiku is the paid-tier default: labeling a control from its HTML
    // context is well within its ability, it is the fastest option, and it
    // keeps the ~$0.01/page economics the pricing plan is built on.
    // Set to "claude-opus-4-8" for maximum label quality.
    "MODEL": "claude-haiku-4-5",
    // Credits granted when /admin/tokens is called without ?credits=N.
    // 1 credit = 1 labeling request (one page repair, up to 40 controls).
    "DEFAULT_STARTING_CREDITS": "25"
  }
  // Secrets (set with `wrangler secret put <NAME>`):
  //   ANTHROPIC_API_KEY  — the server-held key all paid traffic uses
  //   ADMIN_SECRET       — authorizes POST /admin/tokens
  //   STRIPE_WEBHOOK_SECRET (later) — verifies Stripe event signatures
}
